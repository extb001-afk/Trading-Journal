# tj-bot 비밀값 — 보통은 웹 설정 화면(http://127.0.0.1:8023/)이 이 파일을 대신 관리합니다.
# 직접 쓸 때: .env 로 복사 → chmod 600 .env → 필요한 줄만 채우기. KEY=value (공백·따옴표 없이).
# ★절대 공유·커밋하지 마세요.★ 개인 키·시드 문구는 어디에도 필요 없습니다 — 이 봇은 조회만 합니다.

# ── 탐색기 ──
# Solana 지갑이 있으면 필수 (무료: https://dashboard.helius.dev)
TJ_HELIUS_KEY=
# EVM 지갑이 있으면 필수 — 경고만 · EVM 과거 거래 백필 가속 (무료: https://etherscan.io/myapikey · 없으면 공개 노드(RPC)로만 — 옛 기록이 늦음 · 최신 거래는 바로)
#        HyperEVM 은 이 키로만 받음(없으면 HyperEVM 안 켜짐)
TJ_ETHERSCAN_KEY=
# 선택 — 코인게코 시세·DEX 토큰 시세·원가·차트·NFT 바닥가를 키 한도로 빠르게 (거래소 값이 없는 코인 몫만 · 몫이 모자라거나 실패하면 그 콜만 무키로)
#        데모 또는 프로 키 — 자동 판별: https://www.coingecko.com/en/developers/dashboard → 무료 Demo 키, 유료 Pro 키도 그대로 ·
#        프로는 플랜 한도의 10% 만 씀 — 설정 › 연결·키의 '사용 비율'로 25·50·80%  (자세히: docs/API_KEYS.md)
TJ_COINGECKO_KEY=
# 선택 — EVM NFT 바닥가를 오픈시에서 먼저 (무료 신청: https://docs.opensea.io/reference/api-keys)
TJ_OPENSEA_KEY=
# EVM 지갑이 있으면 필수 — 경고만 · 지갑이 주고받은 토큰 전부 + 지금 잔고 찾기(감시·백필엔 안 씀 · 없으면 옛 보유 토큰 찾기가 약해짐)
#        (무료 월 3,000만 CU: https://dashboard.alchemy.com/signup → Create new app → API Key · 키만 — 저장 즉시 사용, 재시작 없음)
TJ_ALCHEMY_KEY=
# EVM 지갑이 있으면 필수 — 경고만 · 오래 안 쓴 지갑에 들어온 토큰 10분마다 확인 + BNB Chain·Base 옛 기록(아카이브) 가속 + 같은 키로 토큰 찾기 보조
#        (무료 Freemium: https://www.ankr.com/rpc/ · 없으면 공개 노드로만 — 늦을 수 있음 · 설정 화면에서 저장하면 연결 1콜 확인)
TJ_ANKR_KEY=
# 선택 — BNB Chain·Base 옛 기록(아카이브) 노드. 없으면 공개 노드(BNB Chain 은 공개 노드 보관 기간까지만) · 요금제·사용 비율은 설정 › 연결·키
#        NodeReal(BSC · 무료 키 있음) · QuickNode(유료 요금제나 1개월 무료 체험(크레딧 1,000만·초당 15) 키가 있으면 — 상시 무료 없음 · 체험이 끝나면 유료로 바꾸거나 키를 지우세요 ·
#        키가 계속 거부되면 봇이 알아서 빼고 기본 노드로 · 멀티체인 엔드포인트 주소 하나(아무 체인 주소 — 체인별 주소는 봇이 만듦) · 한도의 80%(유료는 비율 고름 · 기본 80%) ·
#        Base 내부 이동 trace + 남는 몫으로 BNB Chain·Base 옛 잔고 — getLogs 엔 안 씀)
#        노드 키는 키만(QuickNode 는 엔드포인트 주소 그대로) — 노드 주소는 봇이 메모리에서 만듦(config.json 에 키를 박지 마세요) · 서비스마다 장부로 공표 무료 한도의 80% 안
#        (옛 TJ_QUICKNODE_BSC_KEY·TJ_QUICKNODE_BASE_KEY 는 TJ_QUICKNODE_KEY 가 비었을 때만 읽음 — 설정 화면에서 새 칸을 저장하면 지워짐)
TJ_NODEREAL_KEY=
TJ_QUICKNODE_KEY=
# 선택 — Base 내부 이동 확인(trace) 무료 제공자 Chainnodes(무료 Core 월 1,250만 요청·초당 25 — https://www.chainnodes.org/ · 키 = 8-4-4-4-12 형식 ·
#        Base trace 에만 씀(로그·잔고엔 안 씀) · 순서 = Chainnodes → QuickNode(키 있으면) → 기본 노드 · 최근 약 45일보다 옛 거래는 다음 노드가 맡음 · 월 한도의 80%)
TJ_CHAINNODES_KEY=
# 선택 — 새 체인 지갑(Tron·TON) 수집·잔고 대조를 빠르게. 없으면 공용 무키(Tron 초당 0.8회 · TON 초당 1회 — 옛 기록이 느림). 헤더로만 보냄 · 공표 한도의 80% 안
#        TronGrid 무료 키: https://www.trongrid.io · toncenter 무료 키: https://t.me/tonapibot  (Sui·Bitcoin 은 키 없이 공개 API)
TJ_TRONGRID_KEY=
TJ_TONCENTER_KEY=

# ── 거래소 (전부 선택 · '조회/읽기' 권한만 켠 키 + IP 화이트리스트) ──
UPBIT_ACCESS=
UPBIT_SECRET=
TJ_BITHUMB_KEY=
TJ_BITHUMB_SECRET=
TJ_BINANCE_KEY=
TJ_BINANCE_SECRET=
TJ_BYBIT_KEY=
TJ_BYBIT_SECRET=
TJ_OKX_KEY=
TJ_OKX_SECRET=
TJ_OKX_PASSPHRASE=
TJ_KUCOIN_KEY=
TJ_KUCOIN_SECRET=
TJ_KUCOIN_PASSPHRASE=
TJ_GATE_KEY=
TJ_GATE_SECRET=
# 서브계정(선택 · 바이낸스·바이빗·OKX·쿠코인·게이트 · 거래소마다 1~5개) — 메인 키 이름 가운데에 SUB<번호>_ 를 넣어요.
#   같은 거래소로 합쳐 세고, 화면 기록 줄엔 '· 서브1' 딱지만 붙어요. 설정 › 연결·키 › 거래소 칸의 '서브계정 키 추가'로 넣어도 돼요(권한 확인·연결 시험 같음).
# TJ_BYBIT_SUB1_KEY=
# TJ_BYBIT_SUB1_SECRET=
# TJ_OKX_SUB1_KEY=
# TJ_OKX_SUB1_SECRET=
# TJ_OKX_SUB1_PASSPHRASE=

# 코인베이스 = CDP 키(ECDSA · View 만) — 이름 organizations/…/apiKeys/… · 비밀키는 설정 화면에 PEM 통째로 붙여넣으면 base64 본문 한 줄로 저장돼요
TJ_COINBASE_KEY_NAME=
TJ_COINBASE_SECRET=

# ── 텔레그램 알림 (선택 — 웹 설정 화면의 '텔레그램' 단계가 자동으로 채웁니다) ──
TJ_TG_TOKEN=
TJ_TG_CHAT=
