# tj-bot 비밀값 — 보통은 웹 설정 화면(http://127.0.0.1:8023/)이 이 파일을 대신 관리합니다.
# 직접 쓸 때: .env 로 복사 → chmod 600 .env → 필요한 줄만 채우기. KEY=value (공백·따옴표 없이).
# ★절대 공유·커밋하지 마세요.★ 개인 키·시드 문구는 어디에도 필요 없습니다 — 이 봇은 조회만 합니다.

# ── 탐색기 ──
# Solana 지갑이 있으면 필수 (무료: https://dashboard.helius.dev)
TJ_HELIUS_KEY=
# EVM 지갑이 있으면 필수 — 경고만(없어도 공개 탐색기·RPC 로 돌지만 느리거나 늦게 기록) (무료: https://etherscan.io/myapikey)
TJ_ETHERSCAN_KEY=
# 선택 — 코인게코 시세·DEX 토큰 시세·원가·차트·NFT 바닥가를 키 한도로 빠르게 (거래소 값이 없는 코인 몫만 · 몫이 모자라거나 실패하면 그 콜만 무키로)
#        데모 또는 프로 키 — 자동 판별: https://www.coingecko.com/en/developers/dashboard → 무료 Demo 키, 유료 Pro 키도 그대로 ·
#        프로는 플랜 한도의 10% 만 씀 — 설정 › 연결·키의 '사용 비율'로 25·50·80%  (자세히: docs/API_KEYS.md)
TJ_COINGECKO_KEY=
# 선택 — EVM NFT 바닥가를 오픈시에서 먼저 (무료 신청: https://docs.opensea.io/reference/api-keys)
TJ_OPENSEA_KEY=
# EVM 지갑이 있으면 필수 — 경고만 · 지갑이 주고받은 토큰 전부 + 지금 잔고 찾기(감시·백필엔 안 씀 · 없으면 옛 보유 토큰 찾기가 약해짐)
#        (무료 월 3,000만 CU: https://dashboard.alchemy.com/signup → Create new app → API Key · 키만 — 저장 즉시 사용, 재시작 없음)
TJ_ALCHEMY_KEY=
# 선택 — BNB Chain·Base 옛 기록(아카이브) 노드. 없으면 공개 노드(BNB Chain 은 공개 노드 보관 기간까지만) · 요금제·사용 비율은 설정 › 연결·키
#        NodeReal(BSC · 무료 키 있음) · Ankr(BSC·Base · 무료 키 있음 · 같은 키로 토큰 찾기 보조) · QuickNode(유료 — 체인별 엔드포인트 주소 그대로)
#        노드 키는 키만 — 노드 주소는 봇이 메모리에서 만듦(config.json 에 키를 박지 마세요) · 서비스마다 하루 장부로 공표 무료 한도의 80% 안
TJ_NODEREAL_KEY=
TJ_ANKR_KEY=
TJ_QUICKNODE_BSC_KEY=
TJ_QUICKNODE_BASE_KEY=

# ── 거래소 (전부 선택 · '조회/읽기' 권한만 켠 키 + IP 화이트리스트) ──
UPBIT_ACCESS=
UPBIT_SECRET=
TJ_BITHUMB_KEY=
TJ_BITHUMB_SECRET=
TJ_BINANCE_KEY=
TJ_BINANCE_SECRET=
TJ_BYBIT_KEY=
TJ_BYBIT_SECRET=
TJ_OKX_KEY=
TJ_OKX_SECRET=
TJ_OKX_PASSPHRASE=
TJ_KUCOIN_KEY=
TJ_KUCOIN_SECRET=
TJ_KUCOIN_PASSPHRASE=
TJ_GATE_KEY=
TJ_GATE_SECRET=

# ── 텔레그램 알림 (선택 — 웹 설정 화면의 '텔레그램' 단계가 자동으로 채웁니다) ──
TJ_TG_TOKEN=
TJ_TG_CHAT=
