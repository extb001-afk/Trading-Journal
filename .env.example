# tj-bot 비밀값 — 보통은 웹 설정 화면(http://127.0.0.1:8023/)이 이 파일을 대신 관리합니다.
# 직접 쓸 때: .env 로 복사 → chmod 600 .env → 필요한 줄만 채우기. KEY=value (공백·따옴표 없이).
# ★절대 공유·커밋하지 마세요.★ 개인 키·시드 문구는 어디에도 필요 없습니다 — 이 봇은 조회만 합니다.

# ── 탐색기 ──
# Solana 지갑이 있으면 필수 (무료: https://dashboard.helius.dev)
TJ_HELIUS_KEY=
# 선택 — EVM 과거 거래 백필 가속 (무료: https://etherscan.io/myapikey)
TJ_ETHERSCAN_KEY=
# 선택 — NFT 바닥가 빠르게 (코인게코 무료 데모 키: https://www.coingecko.com/en/developers/dashboard → Demo 키)
TJ_COINGECKO_KEY=
# 선택 — 넣으면 EVM NFT 바닥가를 오픈시에서 먼저 받음(작은 컬렉션까지 · 없거나 실패하면 코인게코) (무료 신청: https://docs.opensea.io/reference/api-keys)
TJ_OPENSEA_KEY=

# ── 거래소 (전부 선택 · '조회/읽기' 권한만 켠 키 + IP 화이트리스트) ──
UPBIT_ACCESS=
UPBIT_SECRET=
TJ_BITHUMB_KEY=
TJ_BITHUMB_SECRET=
TJ_BINANCE_KEY=
TJ_BINANCE_SECRET=
TJ_BYBIT_KEY=
TJ_BYBIT_SECRET=
TJ_OKX_KEY=
TJ_OKX_SECRET=
TJ_OKX_PASSPHRASE=
TJ_KUCOIN_KEY=
TJ_KUCOIN_SECRET=
TJ_KUCOIN_PASSPHRASE=
TJ_GATE_KEY=
TJ_GATE_SECRET=

# ── 텔레그램 알림 (선택 — 웹 설정 화면의 '텔레그램' 단계가 자동으로 채웁니다) ──
TJ_TG_TOKEN=
TJ_TG_CHAT=
